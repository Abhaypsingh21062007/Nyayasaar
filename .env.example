# NyayaSaar — Environment Variables
# Copy this file to .env and fill in your API key.
# IMPORTANT: Never commit .env to version control.

# ── Gemini AI ──────────────────────────────────────────────────────────────
# Get your key from: https://aistudio.google.com/app/apikey
# Used for: document analysis, clause explanation, chat Q&A, AND embeddings (RAG)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the Gemini model (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# ── Server ─────────────────────────────────────────────────────────────────
PORT=5000

# ── Supabase (Optional — for persistent vector storage) ────────────────────
# If NOT set, NyayaSaar uses in-memory vector store (resets on server restart).
# If SET, vector embeddings are persisted in Supabase pgvector (requires setup).
# Get your keys from: https://supabase.com/dashboard
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
